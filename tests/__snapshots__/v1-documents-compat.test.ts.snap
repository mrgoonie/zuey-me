        "description": "Unique within the document; generated when omitted",
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "type": "string",
      },
      "mode": {
        "default": "display",
        "description": "\`display\`: centred on its own line (scrolls horizontally when wide). \`inline\`: text-sized, left-aligned in the reading flow.",
        "enum": [
          "display",
          "inline",
        ],
        "type": "string",
      },
      "numbered": {
        "default": false,
        "description": "Display math only: show an equation number, counted in document order. TeX that numbers itself (equation, align, gather, \\tag) keeps its own numbers instead.",
        "type": "boolean",
      },
      "tex": {
        "description": "TeX source (KaTeX subset), without surrounding $ or $$. Typeset on the server to HTML plus MathML; the source stays readable and copyable. Malformed TeX is shown as source with an error note. \\href, \\url, \\includegraphics and \\html* commands are not trusted and render as plain text.",
        "maxLength": 10000,
        "type": "string",
      },
      "type": {
        "const": "math",
        "type": "string",
      },
    },
    "required": [
      "type",
      "tex",
    ],
    "type": "object",
  },
