# Cloudflare Credentials (for CI/CD and deployment)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Public Configuration
PUBLIC_SITE_URL=https://zuey.me
PUBLIC_POSTHOG_KEY=phc_your_posthog_key
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# OAuth SSO for Page Builder Studio (Optional)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Break-glass Admin Token (Optional)
ADMIN_MASTER_TOKEN=your_secure_break_glass_token

# Salt for hashing survey voter identity (required for surveys)
SURVEY_HASH_SALT=

# Zuey Reads (AnyMD sync + Workers AI summaries via the `AI` binding)
ANYMD_API_KEY=
READS_SUMMARY_MODEL=

# Booking: Google Calendar / Meet (OAuth refresh token reuses GOOGLE_CLIENT_ID/SECRET)
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Booking payments: Polar (USD card)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_CONSULTATION_PRODUCT_ID=
POLAR_API_BASE=

# Booking payments: SePay (VND bank transfer)
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=
CONSULTATION_PRICE_VND=

# Transactional email (booking confirmation + ICS)
RESEND_API_KEY=
RESEND_FROM=

# Membership: admins are verified emails in this comma list (default: goon.nguyen@gmail.com,duy@wearetopgroup.com)
ADMIN_EMAILS=
# Salt for hashing client IPs in sign-in rate limits
MEMBER_HASH_SALT=
# Membership billing (SePay VND, reuses SEPAY_BANK_ACCOUNT / SEPAY_BANK_CODE / SEPAY_WEBHOOK_API_KEY)
# VND per 1 USD; plan prices are USD x rate rounded up to 1,000 VND
USD_VND_RATE=
# SePay user API token for admin reconciliation (/api/v1/billing/reconcile)
SEPAY_API_TOKEN=
# Zuey AI chat (Dewee gateway; token stays server-side, agent key defaults to zuey-ai)
DEWEE_GATEWAY_URL=
DEWEE_GATEWAY_TOKEN=
DEWEE_AGENT_KEY=
