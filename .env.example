# Cloudflare Credentials (for CI/CD and deployment)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Public Configuration
PUBLIC_SITE_URL=https://zuey.me
PUBLIC_POSTHOG_KEY=phc_your_posthog_key
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# OAuth SSO for Page Builder Studio (Optional)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Break-glass Admin Token (Optional)
ADMIN_MASTER_TOKEN=your_secure_break_glass_token

# Salt for hashing survey voter identity (required for surveys)
SURVEY_HASH_SALT=

# Zuey Reads (AnyMD sync + Workers AI summaries via the `AI` binding)
ANYMD_API_KEY=
READS_SUMMARY_MODEL=

# Booking: Google Calendar / Meet (OAuth refresh token reuses GOOGLE_CLIENT_ID/SECRET)
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Booking payments: PayPal Business (USD 1,999 consultation; option hidden until all three are set)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional: https://api-m.sandbox.paypal.com for sandbox (default https://api-m.paypal.com)
PAYPAL_API_BASE=

# Membership card subscriptions: Dodo Payments (USD monthly; option hidden until key, secret and product are set)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_KNOWLEDGES=
DODO_PRODUCT_AI=
DODO_PRODUCT_COMBO=
DODO_PRODUCT_COMMUNITY=
# Courses: one pay-what-you-want one-time product; each checkout sets the final USD amount
DODO_PRODUCT_COURSE=
# Optional: https://test.dodopayments.com for test mode (default https://live.dodopayments.com)
DODO_API_BASE=

# Booking payments: SePay (VND bank transfer)
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=
CONSULTATION_PRICE_VND=

# Transactional email (booking confirmation + ICS)
RESEND_API_KEY=
RESEND_FROM=
# Resend webhook signing secret (whsec_…) for /api/webhooks/resend: bounce/complaint suppression
RESEND_WEBHOOK_SECRET=

# New-article emails to members (sent 30 minutes after the first publish by the cron worker in workers/scheduler)
# Optional sender for article emails (default RESEND_FROM), e.g. "Zuey <news@news.zuey.me>"
ARTICLE_EMAIL_FROM=
ARTICLE_EMAIL_REPLY_TO=
# Warm-up ceiling for a rolling 24 hours (default 2000); quiet hours in Asia/Ho_Chi_Minh ("23-7" default, "off")
ARTICLE_EMAIL_DAILY_CAP=
ARTICLE_EMAIL_QUIET_HOURS=
# Shared secret between the Pages app and the zuey-me-scheduler worker
CRON_SECRET=

# Membership: admins are verified emails in this comma list (default: goon.nguyen@gmail.com,duy@wearetopgroup.com)
ADMIN_EMAILS=
# Salt for hashing client IPs in sign-in rate limits
MEMBER_HASH_SALT=
# Extra browser origins allowed to call /mcp, comma-separated (same origin + localhost always allowed)
MCP_ALLOWED_ORIGINS=
# Membership billing (SePay VND, reuses SEPAY_BANK_ACCOUNT / SEPAY_BANK_CODE / SEPAY_WEBHOOK_API_KEY)
# VND per 1 USD; plan prices are USD x rate rounded up to 1,000 VND
USD_VND_RATE=
# SePay user API token for admin reconciliation (/api/v1/billing/reconcile)
SEPAY_API_TOKEN=
# Zuey AI chat (Dewee gateway; token stays server-side, agent key defaults to zuey-ai)
DEWEE_GATEWAY_URL=
DEWEE_GATEWAY_TOKEN=
DEWEE_AGENT_KEY=
# Zuey AI chat limits: requests per member per month (default 300); blended USD per 1M tokens (default 0.5)
# used to estimate spend against each plan's monthly AI budget ($3 AI, $5 combo/community)
AI_MONTHLY_REQUEST_LIMIT=
AI_EST_COST_USD_PER_MTOK=
# Jev relevance layer (TypeSafe AI): reranks knowledge search and Zuey AI grounding when the key is set
TYPESAFEAI_API_KEY=
TYPESAFE_API_BASE=
TYPESAFE_MODEL=
# Hosts interactive AI blocks may GET through /api/v1/sandbox/fetch (comma list; *.example.com allowed). Empty = proxy disabled
SANDBOX_FETCH_ALLOWLIST=
# Telegram community ($29 plan). The bot must be an admin of both private groups with
# "Invite users via link" and "Ban users" rights. Register the webhook once:
#   setWebhook url=https://zuey.me/api/v1/community/telegram-webhook secret_token=$TELEGRAM_WEBHOOK_SECRET allowed_updates=["chat_member"]
# Without these the community endpoints answer 503 community_unconfigured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_EN_ID=
TELEGRAM_GROUP_VI_ID=
TELEGRAM_WEBHOOK_SECRET=
# Admin group for new-order notices from the SePay webhook (bot only needs to be a member). Empty = no notices
TELEGRAM_GROUP_ID_SEPAY_NOTI=
# Discord channel webhook URL for the same new-order notices (secret). Empty = no Discord notices
DISCORD_WEBHOOK_SEPAY_NOTI=
# Courses. Private audio/files live in the R2 binding COURSE_FILES (see wrangler.toml); videos in Cloudflare Stream
# with signed playback. Media links are HMAC-signed with COURSE_MEDIA_SECRET (long random string).
COURSE_MEDIA_SECRET=
CF_STREAM_CUSTOMER_CODE=
CF_STREAM_SIGNING_KEY_ID=
# The `jwk` value returned by POST /accounts/{id}/stream/keys, base64-decoded to JSON
CF_STREAM_SIGNING_JWK=
# Fine-grained token with Administration: write on the private course repositories (collaborator invites)
GITHUB_COURSES_TOKEN=
