---
/**
 * Shared layout of the course legal pages (/terms, /policy): title, version, highlights box, numbered
 * sections with a table of contents. Vietnamese is authoritative; every other locale reads the English
 * translation (same rule as /privacy). Mirrors the /privacy visual style.
 */
import Layout from '../../layouts/Layout.astro';
import { COURSE_TERMS_VERSION } from '../../lib/courses/course-terms';
import { LOCALE_LABELS, resolveLocale } from '../../lib/i18n/locales';

export interface LegalSection {
  id: string;
  title: string;
  paras?: string[];
  items?: string[];
}

export interface LegalContent {
  title: string;
  intro: string;
  highlightsTitle: string;
  highlights: string[];
  sections: LegalSection[];
}

export type LegalLang = 'vi' | 'en';

interface Props {
  path: '/terms' | '/policy';
  content: Record<LegalLang, LegalContent>;
}

const CHROME: Record<LegalLang, {
  back: string; version: string; appliesFrom: string; seeAlso: string; and: string;
  terms: string; policy: string; privacy: string; authoritative: string; toc: string; contact: string; contactTail: string;
}> = {
  vi: {
    back: '← Khoá học', version: 'Phiên bản', appliesFrom: 'Áp dụng cho mọi đơn mua khoá học từ ngày này', seeAlso: 'Xem thêm', and: 'và',
    terms: 'Điều khoản sử dụng', policy: 'Chính sách khoá học', privacy: 'Chính sách quyền riêng tư',
    authoritative: 'Bản tiếng Việt là bản gốc. Bản tiếng Anh là bản dịch.', toc: 'Mục lục',
    contact: 'Câu hỏi về khoá học, đơn hàng hoặc tài khoản: email', contactTail: 'Khi liên hệ về đơn hàng, vui lòng gửi kèm mã đơn (bắt đầu bằng ZSC).',
  },
  en: {
    back: '← Courses', version: 'Version', appliesFrom: 'Applies to every course purchase from this date', seeAlso: 'See also', and: 'and',
    terms: 'Terms of Use', policy: 'Course Policy', privacy: 'Privacy Policy',
    authoritative: 'The Vietnamese version is authoritative. This English text is a translation.', toc: 'Contents',
    contact: 'Questions about a course, an order or your account: email', contactTail: 'For an order, please include its order code (starting with ZSC).',
  },
};

const { path, content } = Astro.props;
const locale = resolveLocale(Astro.request);
const lang: LegalLang = locale === 'vi' ? 'vi' : 'en';
Astro.response.headers.set('Vary', 'Cookie, Accept-Language');
const c = content[lang];
const t = CHROME[lang];
const other = path === '/terms' ? { href: '/policy', label: t.policy } : { href: '/terms', label: t.terms };
---

<Layout title={`${c.title} — zuey.me`} description={c.intro} url={`https://zuey.me${path}`} lang={LOCALE_LABELS[lang].htmlLang}>
  <main class="relative min-h-screen w-full flex flex-col items-center py-6 sm:py-12 px-2.5 sm:px-4 z-10">
    <article class="w-full max-w-[760px] bg-[#F5EFEB] rounded-[28px] border border-stone-200/90 shadow-floating-card px-4 py-7 sm:p-10 text-stone-900" aria-labelledby="legal-title">
      <a href="/courses" class="text-xs font-semibold text-stone-600 hover:text-stone-900 underline-offset-2 hover:underline">{t.back}</a>
      <h1 id="legal-title" class="mt-4 text-3xl sm:text-4xl font-bold font-serif tracking-tight">{c.title}</h1>
      <p class="mt-2 text-xs text-stone-600">
        {t.version} <time datetime={COURSE_TERMS_VERSION}>{COURSE_TERMS_VERSION}</time> · {t.appliesFrom} · {t.authoritative}
        {lang === 'en' ? <span> · <a class="underline underline-offset-2" href="?lang=vi" hreflang="vi">Tiếng Việt</a></span> : <span> · <a class="underline underline-offset-2" href="?lang=en" hreflang="en">English</a></span>}
        · {t.seeAlso} <a class="underline underline-offset-2" href={other.href}>{other.label}</a> {t.and} <a class="underline underline-offset-2" href="/privacy">{t.privacy}</a>
      </p>
      <p class="mt-4 text-[15px] leading-relaxed text-stone-800">{c.intro}</p>

      <nav class="mt-6 rounded-2xl bg-white/70 border border-stone-200 p-4" aria-label={`${t.toc} ${c.title}`}>
        <ol class="grid gap-1 text-sm list-decimal pl-5">
          <li><a class="underline underline-offset-2 hover:text-black" href="#highlights">{c.highlightsTitle}</a></li>
          {c.sections.map(sec => <li><a class="underline underline-offset-2 hover:text-black" href={`#${sec.id}`}>{sec.title}</a></li>)}
        </ol>
      </nav>

      <section id="highlights" class="mt-8 rounded-2xl bg-[#1c1917] text-[#f5efeb] p-5 sm:p-6">
        <h2 class="text-xl font-bold font-serif">{c.highlightsTitle}</h2>
        <ul class="mt-3 grid gap-2 text-[15px] leading-relaxed list-disc pl-5">
          {c.highlights.map(h => <li>{h}</li>)}
        </ul>
      </section>

      {c.sections.map(sec => (
        <section id={sec.id} class="mt-8 scroll-mt-6">
          <h2 class="text-xl font-bold font-serif">{sec.title}</h2>
          {sec.paras?.map(p => <p class="mt-3 text-[15px] leading-relaxed text-stone-800">{p}</p>)}
          {sec.items && (
            <ul class="mt-3 grid gap-2 text-[15px] leading-relaxed text-stone-800 list-disc pl-5">
              {sec.items.map(i => <li>{i}</li>)}
            </ul>
          )}
        </section>
      ))}

      <section id="contact" class="mt-8 rounded-2xl bg-white/70 border border-stone-200 p-4 text-[15px]">
        {t.contact} <a class="font-semibold underline" href="mailto:hi@zuey.me">hi@zuey.me</a>. {t.contactTail}
      </section>
    </article>
  </main>
</Layout>
