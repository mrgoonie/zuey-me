---
import Layout from '../../layouts/Layout.astro';
import { CoursePrice } from '../../components/courses/CoursePrice';
import { fmtMinutes, levelLabel } from '../../components/courses/course-ui';
import type { CourseCard } from '../../lib/courses/course-views';
import { courseCatalog } from '../../lib/courses/course-views';
import { resolvePrincipal } from '../../lib/members/policy';

// Prices are personal (subscriber discount) and ownership badges depend on the viewer: never shared-cache.
const env = Astro.locals.runtime?.env ?? {};
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Vary', 'Cookie');

let courses: CourseCard[] = [];
let loadError = false;
if (env.DB) {
  try {
    courses = await courseCatalog(env.DB, env, await resolvePrincipal(Astro.request, env));
  } catch (err) {
    console.error('Course catalog failed:', err instanceof Error ? err.message : 'unknown');
    loadError = true;
  }
} else {
  loadError = true;
}
if (loadError) Astro.response.status = 503;
---

<Layout
  title="Khoá học — Zuey"
  description="Khoá học thực chiến của Duy Nguyen (Zuey): mua một lần, học trọn đời, có bài học thử miễn phí, quiz, chứng chỉ và Zuey AI hỗ trợ."
  url="https://zuey.me/courses"
  lang="vi"
>
  <main class="relative min-h-screen w-full flex flex-col items-center gap-6 py-6 sm:py-12 px-2.5 sm:px-4 z-10">
    <header class="w-full max-w-[1100px] text-center text-stone-100">
      <a href="/" class="text-xs font-semibold text-stone-300 hover:text-white underline">← zuey.me</a>
      <h1 class="mt-3 text-3xl sm:text-4xl font-bold font-serif">Khoá học</h1>
      <p class="mt-2 text-sm text-stone-300 max-w-[640px] mx-auto">Mua một lần, học trọn đời. Mỗi khoá có bài học thử miễn phí; thành viên các gói được giảm giá tự động.</p>
      <p class="mt-2 text-xs text-stone-300"><a href="/courses/leaderboard" class="underline hover:text-white">Bảng xếp hạng học viên</a> · <a href="/account#learning" class="underline hover:text-white">Khoá học của tôi</a></p>
    </header>

    {loadError && (
      <p class="w-full max-w-[720px] rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm p-3" role="alert">Tạm thời không tải được danh sách khoá học. Vui lòng thử lại sau ít phút.</p>
    )}
    {!loadError && courses.length === 0 && (
      <p class="w-full max-w-[720px] rounded-2xl bg-[#F5EFEB] border border-stone-200/90 text-stone-800 text-sm p-5 text-center">Khoá học đầu tiên đang được hoàn thiện. Quay lại sớm nhé!</p>
    )}

    <ul class="w-full max-w-[1100px] grid gap-4 sm:grid-cols-2 lg:grid-cols-3 min-w-0">
      {courses.map(c => (
        <li class="min-w-0">
          <a
            href={c.url}
            class="group flex h-full flex-col overflow-hidden rounded-[28px] border border-stone-200/90 bg-[#F5EFEB] text-stone-900 shadow-floating-card hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2"
          >
            <div class="relative w-full bg-stone-900" style="aspect-ratio: 16 / 9">
              {c.cover_url && <img src={c.cover_url} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover group-hover:opacity-95" />}
              {c.owned && <span class="absolute left-3 top-3 rounded-full bg-emerald-600 px-2.5 py-1 text-[11px] font-bold text-white">Đã sở hữu</span>}
              {c.status !== 'published' && <span class="absolute right-3 top-3 rounded-full bg-amber-300 px-2.5 py-1 text-[11px] font-bold text-stone-900">Bản nháp</span>}
            </div>
            <div class="flex flex-1 flex-col p-5 min-w-0">
              <p class="flex flex-wrap gap-x-3 gap-y-1 text-[11px] font-bold uppercase tracking-wider text-stone-500">
                <span>{levelLabel(c.level)}</span>
                <span>{c.lesson_count} bài</span>
                {c.duration_minutes > 0 && <span>{fmtMinutes(c.duration_minutes)}</span>}
                {c.trial_lesson_count > 0 && <span class="text-emerald-700">{c.trial_lesson_count} bài học thử</span>}
              </p>
              <h2 class="mt-2 text-xl font-bold font-serif leading-snug break-words">{c.title}</h2>
              {c.subtitle && <p class="mt-1 text-sm text-stone-600 break-words">{c.subtitle}</p>}
              {c.release_note && <p class="mt-3 rounded-xl bg-amber-50 border border-amber-200 px-3 py-2 text-xs text-stone-800">{c.release_note}</p>}
              <div class="mt-auto pt-4">
                {c.owned
                  ? <p class="text-sm font-semibold text-emerald-800">Vào học →</p>
                  : <CoursePrice quote={c.price} />}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="text-xs text-stone-300 text-center max-w-[720px]">Mua khoá học nghĩa là bạn đồng ý <a href="/terms" class="underline hover:text-white">Điều khoản sử dụng</a> và <a href="/policy" class="underline hover:text-white">Chính sách khoá học</a> (không hoàn tiền).</p>
  </main>
</Layout>
