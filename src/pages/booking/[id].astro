---
import Layout from '../../layouts/Layout.astro';
import { BookingManage } from '../../components/booking/BookingWidget';

// The manage token stays in the query string and is read client-side only.
const id = Astro.params.id ?? '';
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<Layout
  title="Quản lý lịch tư vấn — Zuey for Business"
  description="Xem trạng thái, link Google Meet và dời lịch tư vấn Zuey for Business."
  url={`https://zuey.me/booking/${id}`}
  lang="vi"
>
  <main class="relative min-h-screen w-full flex flex-col items-center py-6 sm:py-12 px-2.5 sm:px-4 z-10">
    <BookingManage client:load bookingId={id} />
    <a href="/business" class="mt-4 text-xs font-semibold text-stone-200 hover:text-white underline">Zuey for Business</a>
  </main>
</Layout>
