---
import Layout from '../layouts/Layout.astro';
import { PricingTable } from '../components/members/PricingTable';
import { plansCatalog } from '../lib/members/account';
import { isPlanId } from '../lib/members/plans';

const runtimeEnv = Astro.locals.runtime?.env ?? {};
const catalog = plansCatalog(runtimeEnv);
const planParam = Astro.url.searchParams.get('plan');
const initialPlan = isPlanId(planParam) ? planParam : null;
const initialMonths = Number(Astro.url.searchParams.get('months') ?? 1);

// Prices depend only on server configuration, so the page is shareable-cacheable.
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<Layout
  title="Gói thành viên — Zuey"
  description={`Knowledges $9, Zuey AI $9, Kết hợp $19, Cộng đồng $29 mỗi tháng. Trả trước 1, 3, 6 hoặc 12 tháng qua chuyển khoản VietQR${catalog.card_plans.length > 0 ? ", hoặc trả hằng tháng bằng thẻ quốc tế (USD)" : ""}.`}
  url="https://zuey.me/pricing"
  lang="vi"
>
  <main class="relative min-h-screen w-full flex flex-col items-center gap-6 py-6 sm:py-12 px-2.5 sm:px-4 z-10">
    <header class="w-full max-w-[720px] text-center text-stone-100">
      <a href="/" class="text-xs font-semibold text-stone-300 hover:text-white underline">← zuey.me</a>
      <h1 class="mt-3 text-3xl sm:text-4xl font-bold font-serif">Gói thành viên Zuey</h1>
      <p class="mt-2 text-sm text-stone-300">Đọc toàn bộ bài viết, trò chuyện với Zuey AI, hoặc tham gia cộng đồng. Đăng nhập để mua; gói kích hoạt ngay khi hệ thống xác nhận thanh toán{catalog.card_plans.length > 0 ? ' (chuyển khoản VietQR hoặc thẻ quốc tế)' : ''}.</p>
    </header>
    <PricingTable client:load catalog={catalog} initialPlan={initialPlan} initialMonths={initialMonths} />
    <p class="text-xs text-stone-300"><a href="/account#billing" class="underline hover:text-white">Gói của tôi</a> · <a href="/login?next=%2Fpricing" class="underline hover:text-white">Đăng nhập</a></p>
  </main>
</Layout>
