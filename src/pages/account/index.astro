---
import Layout from '../../layouts/Layout.astro';
import { AccountApp } from '../../components/members/AccountApp';
import { ConnectedApps } from '../../components/account/ConnectedApps';
import { USER_KEY_SCOPES } from '../../lib/members/api-keys';
import { resolveMemberSession } from '../../lib/members/session';

const runtimeEnv = Astro.locals.runtime?.env ?? {};
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const current = await resolveMemberSession(Astro.request, runtimeEnv.DB).catch(() => null);
if (!current) return Astro.redirect('/login?next=%2Faccount', 302);
---

<Layout title="Tài khoản — Zuey" description="Quản lý tài khoản, gói thành viên và khoá API Zuey." url="https://zuey.me/account" lang="vi">
  <main class="relative min-h-screen w-full flex flex-col items-center py-6 sm:py-12 px-2.5 sm:px-4 z-10">
    <div class="w-full max-w-[720px] min-w-0">
      <a href="/" class="mb-3 inline-block text-xs font-semibold text-stone-200 hover:text-white underline">← zuey.me</a>
      <AccountApp client:load keyScopes={[...USER_KEY_SCOPES]} />
      <ConnectedApps client:load />
    </div>
  </main>
</Layout>
