---
import Layout from '../../layouts/Layout.astro';
import { listPublicWorkflows } from '../../lib/workflows/store';
import type { PublicWorkflow } from '../../lib/workflows/store';

const d1 = Astro.locals.runtime?.env?.DB;
let workflows: PublicWorkflow[] = [];
let loadFailed = false;
try {
  workflows = await listPublicWorkflows(d1);
} catch (err) {
  loadFailed = true;
  console.error('Failed to load workflows:', err instanceof Error ? err.message : 'unknown');
}
---

<Layout
  title="Zuey's AI Workflows — Duy Nguyen /zuey/"
  description="Real AI workflows Duy Nguyen /zuey/ uses day to day: tools, triggers and step-by-step playbooks."
  url="https://zuey.me/workflows"
>
  <main class="relative min-h-screen w-full flex flex-col items-center py-3 sm:py-8 md:py-12 px-2.5 sm:px-4 md:px-6 z-10">
    <div class="w-full max-w-6xl min-w-0 bg-[#F5EFEB] rounded-[28px] sm:rounded-[36px] md:rounded-[40px] border border-stone-200/90 shadow-floating-card px-3.5 py-6 sm:px-6 sm:py-8 md:p-10">
      <header class="flex flex-wrap items-end justify-between gap-3 mb-6 sm:mb-8">
        <div class="min-w-0">
          <a href="/" class="text-xs font-semibold text-stone-500 hover:text-stone-900">&larr; zuey.me</a>
          <h1 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold text-stone-900 mt-1 break-words">Zuey's AI Workflows</h1>
          <p class="text-sm text-stone-600 mt-1">Playbooks I actually run with AI agents, tools and automations.</p>
        </div>
        <a href="/workflows.md" class="text-xs font-semibold px-3 py-1.5 rounded-full bg-white/90 border border-stone-300/80 text-stone-700 hover:text-stone-900">Markdown</a>
      </header>

      {loadFailed && (
        <p class="rounded-2xl bg-red-50 border border-red-200 text-red-800 text-sm p-4">Workflows are temporarily unavailable. Please try again later.</p>
      )}

      {!loadFailed && workflows.length === 0 && (
        <div class="rounded-3xl border border-dashed border-stone-300 bg-white/60 p-8 text-center">
          <p class="font-serif text-lg text-stone-800">No workflows published yet.</p>
          <p class="text-sm text-stone-500 mt-1">Check back soon — drafts are being polished.</p>
        </div>
      )}

      {workflows.length > 0 && (
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
          {workflows.map(w => (
            <li class="min-w-0">
              <a
                href={`/workflows/${w.slug}`}
                class="group h-full flex flex-col gap-3 rounded-3xl bg-white/90 border border-stone-300/70 shadow-card p-4 sm:p-5 hover:-translate-y-0.5 hover:bg-white transition-all"
              >
                <div class="flex items-start justify-between gap-2">
                  <h2 class="font-serif text-lg font-bold text-stone-900 break-words min-w-0">{w.name}</h2>
                  <span class="shrink-0 text-[11px] font-semibold text-amber-900 bg-amber-100 border border-amber-200 rounded-full px-2 py-0.5">{w.steps.length} steps</span>
                </div>
                <p class="text-sm text-stone-600 break-words">{w.summary}</p>
                {w.tools.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {w.tools.map(t => (
                      <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-stone-900 text-stone-100 break-all">{t}</span>
                    ))}
                  </div>
                )}
                {w.tags.length > 0 && (
                  <div class="mt-auto flex flex-wrap gap-1.5 pt-1">
                    {w.tags.map(t => (
                      <span class="text-[11px] text-stone-600 bg-stone-200/70 rounded-full px-2 py-0.5 break-all">#{t}</span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>
</Layout>
