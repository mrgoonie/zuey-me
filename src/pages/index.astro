---
import Layout from '../layouts/Layout.astro';
import { ZueyOS } from '../components/os/ZueyOS';
import { LOOK_BOOT_SCRIPT } from '../components/os/look';
import { ZueyAiPanel } from '../components/ai/ZueyAiPanel';
import { KnowledgesPanel } from '../components/knowledge/KnowledgesPanel';
import { ReadsWindow } from '../components/reads/ReadsWindow';
import { ZueytubeWindow } from '../components/zueytube/ZueytubeWindow';
import { PricingTable } from '../components/members/PricingTable';
import { BookingWidget } from '../components/booking/BookingWidget';
import BusinessIntro from '../components/booking/BusinessIntro.astro';
import { AccountApp } from '../components/members/AccountApp';
import { LoginForm } from '../components/members/MemberAuth';
import { ConnectedApps } from '../components/account/ConnectedApps';
import { CommunityAccess } from '../components/home/CommunityAccess';
import { ReferralApp } from '../components/referral/ReferralApp';
import { getProfile, getLinks } from '../db/store';
import { LOCALE_LABELS, resolveLocale } from '../lib/i18n/locales';
import { plansCatalog } from '../lib/members/account';
import { USER_KEY_SCOPES } from '../lib/members/api-keys';
import { resolveMemberSession } from '../lib/members/session';
import { configuredPaymentMethods } from '../lib/booking/store';
import { Lab200Window } from '../components/lab200/Lab200Window';

const runtimeEnv = Astro.locals.runtime?.env ?? {};
const d1 = runtimeEnv.DB;

// Reads, Zueytube and 200lab windows load their lists from the API when first opened, so their
// data is neither queried here nor serialized into the page.
const [profile, links, member] = await Promise.all([
  getProfile(d1),
  getLinks(d1),
  resolveMemberSession(Astro.request, d1).catch(() => null),
]);
const catalog = plansCatalog(runtimeEnv);
const paymentMethods = configuredPaymentMethods(runtimeEnv);
const locale = resolveLocale(Astro.request);
// The locale comes from ?lang, the locale cookie or Accept-Language, and the account window
// depends on the session cookie, so caches must key on them (and never store a member's page).
Astro.response.headers.set('Vary', 'Cookie, Accept-Language');
if (member) Astro.response.headers.set('Cache-Control', 'private, no-store');
const description = locale === 'vi' ? profile.intro_vi : profile.intro_en;
---

<Layout
  title={`${profile.name} — Profile & Links`}
  description={description}
  image="https://zuey.me/og.png"
  lang={LOCALE_LABELS[locale].htmlLang}
  ambient={false}
>
  <script is:inline slot="head" set:html={LOOK_BOOT_SCRIPT} />
  <!-- Fonts for the 200lab app window (200lab design tokens); the window is closed at first paint, so they never block it. -->
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" media="print" onload="this.media='all'" />
  <ZueyOS client:load locale={locale} profile={profile} links={links} signedIn={member !== null}>
    <div slot="ai" class="min-w-0 h-full">
      <ZueyAiPanel client:visible locale={locale} />
    </div>
    <div slot="knowledges" class="min-w-0">
      <KnowledgesPanel client:visible locale={locale} />
    </div>
    <div slot="reads" class="min-w-0">
      <ReadsWindow client:visible locale={locale} />
    </div>
    <div slot="zueytube" class="min-w-0">
      <ZueytubeWindow client:visible locale={locale} />
    </div>
    <div slot="pricing" class="min-w-0 flex flex-col items-center gap-4">
      <PricingTable client:visible catalog={catalog} initialPlan={null} initialMonths={1} />
      <p class="text-xs text-stone-300"><a href="/pricing" class="underline hover:text-white">zuey.me/pricing</a> · <a href="/account#billing" class="underline hover:text-white">Gói của tôi</a></p>
    </div>
    <div slot="200lab" class="min-w-0">
      <Lab200Window client:visible locale={locale} />
    </div>
    <div slot="business" class="min-w-0 flex flex-col items-center gap-6">
      <BusinessIntro />
      <BookingWidget client:visible methods={paymentMethods} />
    </div>
    <div slot="account" class="min-w-0 mx-auto w-full max-w-[720px]">
      {member ? (
        <>
          <AccountApp client:visible keyScopes={[...USER_KEY_SCOPES]} />
          <div id="community" class="mt-4"><CommunityAccess client:visible locale={locale} /></div>
          <ConnectedApps client:visible />
        </>
      ) : (
        <div class="flex flex-col items-center gap-4">
          <LoginForm client:visible next="/#account" error={null} />
          <a href="/pricing" class="text-xs font-semibold text-stone-200 hover:text-white underline">Xem các gói thành viên</a>
        </div>
      )}
    </div>
    <div slot="referral" class="min-w-0 mx-auto w-full max-w-[720px]">
      <ReferralApp client:visible locale={locale} signedIn={member !== null} />
    </div>
  </ZueyOS>
</Layout>
