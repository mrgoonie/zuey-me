---
import Layout from '../layouts/Layout.astro';
import { ZueyAiPanel } from '../components/ai/ZueyAiPanel';
import { LOCALE_LABELS, resolveLocale } from '../lib/i18n/locales';
import type { Locale } from '../lib/i18n/locales';

const locale = resolveLocale(Astro.request);

const META: Record<Locale, { title: string; description: string; back: string }> = {
  vi: { title: 'Zuey AI — trò chuyện cùng Zuey', description: 'Hỏi Zuey AI về những gì Zuey đã viết. Câu trả lời dẫn nguồn từ các bài viết trên zuey.me.', back: '← zuey.me' },
  en: { title: 'Zuey AI — chat with Zuey', description: 'Ask Zuey AI about what Zuey has written. Answers cite articles on zuey.me.', back: '← zuey.me' },
  zh: { title: 'Zuey AI — 与 Zuey 对话', description: '向 Zuey AI 询问 Zuey 写过的内容。回答会引用 zuey.me 上的文章。', back: '← zuey.me' },
  ko: { title: 'Zuey AI — Zuey와 대화하기', description: 'Zuey가 쓴 글에 대해 Zuey AI에게 물어보세요. 답변은 zuey.me의 글을 출처로 인용합니다.', back: '← zuey.me' },
  ja: { title: 'Zuey AI — Zuey と話す', description: 'Zuey が書いたことについて Zuey AI に質問できます。回答は zuey.me の記事を出典として示します。', back: '← zuey.me' },
};
const meta = META[locale];

// Per-member state lives in the island; the shell varies by locale cookie, so never share it.
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Vary', 'Cookie, Accept-Language');
---

<Layout title={meta.title} description={meta.description} url="https://zuey.me/chat" lang={LOCALE_LABELS[locale].htmlLang}>
  <main class="relative min-h-screen w-full flex flex-col items-center gap-4 py-6 sm:py-10 px-2.5 sm:px-4 z-10">
    <a href="/" class="self-center text-xs font-semibold text-stone-300 hover:text-white underline">{meta.back}</a>
    <div class="zai-page w-full max-w-[1100px] min-w-0">
      <ZueyAiPanel client:load locale={locale} />
    </div>
  </main>
</Layout>
