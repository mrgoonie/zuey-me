---
import Layout from '../../layouts/Layout.astro';
import { BlockRenderer } from '../../components/blocks/BlockRenderer';
import { ShareMenu } from '../../components/knowledge/ShareMenu';
import { TagBadges } from '../../components/knowledge/TagBadges';
import { EntitlementIcon } from '../../components/knowledge/EntitlementIcon';
import { formatKnowledgeDate, knowledgeStrings } from '../../components/knowledge/strings';
import { getArticleView, resolveViewer } from '../../lib/blocks/articles';
import { canReadFull, readerCacheControl } from '../../lib/blocks/paywall';
import { PAYWALL_SELECTOR, articleAlternates, articleJsonLd, articlePath, articleUrl, jsonLdScript, linkHeader } from '../../lib/blocks/seo';
import { LOCALE_LABELS, isLocale, resolveLocale } from '../../lib/i18n/locales';
import { readingMinutes } from '../../lib/search/text';
import { articleOgImage } from '../../lib/og/article-og-service';
import { relatedVideosForArticle } from '../../lib/videos/related-content';
import { formatDuration } from '../../lib/videos/youtube-url';

const runtimeEnv = Astro.locals.runtime?.env ?? {};
const d1 = runtimeEnv.DB;
const slug = Astro.params.slug ?? '';
const viewer = await resolveViewer(Astro.request, d1, runtimeEnv);
// Draft preview is honoured only for admin sessions; everyone else gets the published version.
const preview = Astro.url.searchParams.get('preview') === '1' && viewer.isAdmin;

// ?lang= picks an edition explicitly (with a notice when it does not exist); otherwise the reader's
// locale preference picks one when available, falling back silently to the primary edition.
const langParam = Astro.url.searchParams.get('lang');
const explicitLocale = isLocale(langParam) ? langParam : undefined;
const preferred = explicitLocale ?? resolveLocale(Astro.request);
let view = await getArticleView(d1, slug, viewer, { draft: preview, locale: preferred });
const fallback = Boolean(view?.locale_fallback && explicitLocale);
if (view && view.locale_fallback && !explicitLocale) view = { ...view, locale_fallback: false };

const uiLocale = view?.locale ?? preferred;
const t = knowledgeStrings(uiLocale);
const origin = (runtimeEnv.PUBLIC_SITE_URL || Astro.url.origin).replace(/\/$/, '');

Astro.response.headers.set('Cache-Control', readerCacheControl(viewer));
Astro.response.headers.set('Vary', 'Cookie, Authorization, Accept-Language');
if (!view) Astro.response.status = 404;
if (preview) Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const canonical = view ? articleUrl(origin, view.slug, view.locale) : `${origin}/articles/${slug}`;
const alternates = view && !preview ? articleAlternates(origin, view.slug, view.available_locales) : [];
if (view && !preview) Astro.response.headers.set('Link', linkHeader(canonical, alternates));
// Generated share card of this edition; its ?v= hash changes with the content so networks re-fetch it.
const shareImage = view && !preview ? `${origin}${(await articleOgImage(view)).path}` : undefined;
const jsonLd = view && !preview ? jsonLdScript(articleJsonLd(view, origin, shareImage ?? 'https://zuey.me/og.png')) : null;
const translations = view ? view.available_locales.filter(l => l !== view?.locale) : [];
const dateText = view ? formatKnowledgeDate(view.published_at, view.locale) : '';
const paywallClass = PAYWALL_SELECTOR.slice(1);
const lockedHeadings = view?.locked_outline?.headings ?? [];
// Zueytube videos related by content (public article text only); a failure just hides the section.
const relatedVideos = view && !view.preview && d1
  ? await relatedVideosForArticle(d1, view.id, view.locale, { origin, limit: 3 }).catch(() => [])
  : [];
const relatedVideosLabel = uiLocale === 'vi' ? 'Video liên quan' : 'Related videos';
const canCopyPrivate = Boolean(view && view.access === 'knowledges' && !view.truncated && !view.preview && canReadFull(viewer));
---

<Layout
  title={view ? `${view.title} — Zuey` : `${t.notFoundTitle} — Zuey`}
  description={view?.excerpt || t.sectionLead}
  url={canonical}
  image={shareImage}
  imageAlt={view?.title}
  lang={LOCALE_LABELS[uiLocale].htmlLang}
>
  {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
  <main class="relative min-h-screen w-full flex flex-col items-center py-3 sm:py-8 md:py-12 px-2.5 sm:px-4 md:px-6">
    <article class="w-full max-w-[860px] min-w-0 bg-[#F5EFEB] rounded-[28px] sm:rounded-[36px] border border-stone-200/90 shadow-modal px-4 py-6 sm:px-8 sm:py-9 md:px-12 md:py-12">
      <nav class="text-xs font-semibold text-stone-500 mb-5 flex flex-wrap gap-3 justify-between items-center">
        <a href={`/articles?lang=${uiLocale}`} class="hover:text-stone-900">← {t.sectionTitle}</a>
        {view && (
          <span class="flex flex-wrap gap-3 items-center">
            <a href={articlePath(view.slug, view.locale, true)} class="hover:text-stone-900" type="text/markdown">{t.markdown}</a>
            {!view.preview && (
              <ShareMenu
                client:visible
                locale={view.locale}
                title={view.title}
                publicUrl={canonical}
                markdownUrl={articleUrl(origin, view.slug, view.locale, true)}
                canCopyPrivate={canCopyPrivate}
              />
            )}
          </span>
        )}
      </nav>

      {view ? (
        <>
          {view.preview && (
            <p class="mb-4 rounded-xl bg-amber-100 border border-amber-300 px-3 py-2 text-xs font-semibold text-amber-900" role="status">
              {t.draftPreview(view.revision)}
            </p>
          )}
          {fallback && explicitLocale && (
            <p class="mb-4 rounded-xl bg-white/80 border border-stone-200 px-3 py-2 text-xs font-semibold text-stone-700" role="status" lang={LOCALE_LABELS[explicitLocale].htmlLang}>
              {knowledgeStrings(explicitLocale).fallbackNotice(LOCALE_LABELS[explicitLocale].native, LOCALE_LABELS[view.locale].native)}
            </p>
          )}
          <header class="mb-7">
            <div class="flex flex-wrap items-center gap-2 mb-3 text-[11px] font-bold uppercase tracking-wider text-stone-500">
              <EntitlementIcon access={view.access} paidLabel={t.paidAria} freeLabel={t.freeAria} />
              {view.access === 'knowledges' && <span class="rounded-full bg-stone-900 text-amber-300 px-2.5 py-1">{t.membersBadge}</span>}
              {view.category && <a href={`/articles?category=${encodeURIComponent(view.category.slug)}&lang=${view.locale}`} class="hover:text-stone-900">{view.category.name}</a>}
              {view.reading_minutes > 0 && <span>{t.minutes(view.reading_minutes)}</span>}
            </div>
            <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-extrabold leading-tight text-stone-950 break-words">{view.title}</h1>
            {view.excerpt && <p class="mt-3 text-stone-600 text-base sm:text-lg">{view.excerpt}</p>}
            {dateText && <p class="mt-3 text-xs text-stone-500"><time datetime={view.published_at ?? undefined}>{dateText}</time></p>}
            <div class="mt-3">
              <TagBadges tags={view.topic_tags} labels={view.labels} linkBase="/articles" query={`lang=${view.locale}`} />
            </div>
            {translations.length > 0 && (
              <p class="mt-3 text-xs text-stone-600">
                {t.alsoIn}:{' '}
                {translations.map((l, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={articlePath(view.slug, l)} hreflang={l} lang={LOCALE_LABELS[l].htmlLang} class="font-semibold underline hover:text-stone-900">{LOCALE_LABELS[l].native}</a>
                  </>
                ))}
              </p>
            )}
          </header>

          <BlockRenderer client:load doc={view.document} articleSlug={view.preview ? undefined : view.slug} interactive={!view.preview} />

          {view.truncated && (
            <div class="zb-lock-wrap">
              {/* Withheld part: only its real headings (readable to assistive tech, visually blurred) and decorative skeleton lines. */}
              <div class={`zb-lock-outline ${paywallClass}`}>
                {lockedHeadings.map(h => {
                  const Tag = h.level === 1 ? 'h2' : h.level === 2 ? 'h3' : 'h4';
                  return (
                    <div class="zb-lock-section">
                      <Tag class={`zb-h zb-h${h.level} zb-lock-h`}><span class="zb-sr-only">{t.lockedSection}: </span><span class="zb-lock-blur">{h.text}</span></Tag>
                      <div class="zb-lock-lines" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                    </div>
                  );
                })}
                {lockedHeadings.length === 0 && <div class="zb-lock-lines" aria-hidden="true"><span></span><span></span><span></span><span></span></div>}
              </div>
              <section class="zb-lockbox" aria-labelledby="locked-title">
                <span class="zb-lockbox-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                </span>
                <p id="locked-title" class="font-serif text-xl font-bold text-stone-900">{t.lockedTitle}</p>
                {view.locked_outline && <p class="mt-1 text-sm font-semibold text-amber-900">{t.lockedMore(lockedHeadings.length, readingMinutes(view.locked_outline.words))}</p>}
                <p class="mt-2 text-sm text-stone-700">{t.lockedBody}</p>
                <div class="mt-4 flex flex-wrap justify-center gap-2">
                  <a href="/pricing" class="zb-lockbox-btn inline-flex min-h-[44px] items-center rounded-full bg-stone-900 text-white px-5 py-2.5 text-sm font-bold hover:bg-stone-800">{t.seePlans}</a>
                  <a href={`/login?next=${encodeURIComponent(articlePath(view.slug, view.locale))}`} class="zb-lockbox-btn inline-flex min-h-[44px] items-center rounded-full border border-stone-300 bg-white px-5 py-2.5 text-sm font-bold text-stone-800 hover:bg-stone-50">{t.signIn}</a>
                </div>
              </section>
            </div>
          )}

          {relatedVideos.length > 0 && (
            <section class="mt-10 border-t border-stone-300/70 pt-6" aria-labelledby="related-videos">
              <h2 id="related-videos" class="text-sm font-bold uppercase tracking-wider text-stone-500 mb-3">{relatedVideosLabel}</h2>
              <ul class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                {relatedVideos.map(v => (
                  <li class="min-w-0">
                    <a href={`/videos?v=${encodeURIComponent(v.youtube_id)}`} class="group block bg-white/80 border border-stone-200/90 rounded-2xl overflow-hidden hover:shadow-md">
                      <div class="relative w-full bg-stone-900" style="aspect-ratio: 16 / 9">
                        {v.thumbnail_url && <img src={v.thumbnail_url} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover group-hover:opacity-90" />}
                        {v.duration_seconds !== null && <span class="absolute bottom-1.5 right-1.5 rounded-md bg-black/80 px-1.5 py-0.5 text-[11px] font-semibold text-white">{formatDuration(v.duration_seconds)}</span>}
                      </div>
                      <p class="p-2.5 text-sm font-serif font-bold leading-snug text-stone-900 line-clamp-2 break-words">{v.title}</p>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </>
      ) : (
        <div class="py-16 text-center">
          <h1 class="font-serif text-3xl font-bold text-stone-900">{t.notFoundTitle}</h1>
          <p class="mt-3 text-stone-600">{t.notFoundBody}</p>
          <a href="/articles" class="mt-6 inline-flex rounded-full bg-stone-900 text-white px-5 py-2.5 text-sm font-bold">{t.viewAll}</a>
        </div>
      )}
    </article>
  </main>
</Layout>
