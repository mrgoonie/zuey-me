---
import Layout from '../../layouts/Layout.astro';
import type { CertificateView } from '../../lib/courses/course-certificates';
import { getCertificate } from '../../lib/courses/course-certificates';

const env = Astro.locals.runtime?.env ?? {};
const raw = Astro.params.code ?? '';
const code = /^[A-Za-z0-9-]{4,40}$/.test(raw) ? raw.toUpperCase() : '';

let cert: CertificateView | null = null;
let unavailable = false;
if (code && env.DB) {
  try {
    cert = await getCertificate(env.DB, env, code);
  } catch (err) {
    console.error('Certificate lookup failed:', err instanceof Error ? err.message : 'unknown');
    unavailable = true;
  }
} else if (code) {
  unavailable = true;
}
if (!cert) Astro.response.status = unavailable ? 503 : 404;
// Public verification page; revocation must show up quickly, so caches stay short.
Astro.response.headers.set('Cache-Control', cert ? 'public, max-age=300' : 'no-store');
if (!cert || cert.revoked) Astro.response.headers.set('X-Robots-Tag', 'noindex');

const issued = cert
  ? new Intl.DateTimeFormat('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh', dateStyle: 'long' }).format(new Date(cert.issued_at))
  : '';
const title = cert
  ? `Chứng chỉ ${cert.course_title} — ${cert.holder_name}`
  : 'Không tìm thấy chứng chỉ — Zuey';
const description = cert
  ? (cert.revoked
    ? `Chứng chỉ ${cert.code} đã bị thu hồi.`
    : `${cert.holder_name} đã hoàn thành khoá học “${cert.course_title}” trên zuey.me ngày ${issued}. Mã xác minh ${cert.code}.`)
  : 'Mã chứng chỉ không tồn tại.';
---

<Layout title={title} description={description} url={cert?.url ?? `https://zuey.me/certificates/${code}`} image="https://zuey.me/og.png" imageAlt={title} lang="vi">
  {(!cert || cert.revoked) && <meta slot="head" name="robots" content="noindex" />}
  <main class="relative min-h-screen w-full flex flex-col items-center gap-4 py-6 sm:py-12 px-2.5 sm:px-4 z-10">
    {cert ? (
      <article class="w-full max-w-[760px] bg-[#F5EFEB] rounded-[28px] border-4 border-double border-amber-700/50 shadow-floating-card px-5 py-10 sm:p-14 text-center text-stone-900" aria-labelledby="cert-title">
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-amber-800">Chứng nhận hoàn thành khoá học</p>
        {cert.revoked && (
          <p class="mt-4 rounded-xl bg-rose-50 border border-rose-300 px-3 py-2 text-sm font-semibold text-rose-800" role="status">
            Chứng chỉ này đã bị thu hồi và không còn hiệu lực.
          </p>
        )}
        <p class="mt-6 text-sm text-stone-600">Chứng nhận rằng</p>
        <h1 id="cert-title" class={`mt-2 font-serif text-3xl sm:text-5xl font-extrabold break-words ${cert.revoked ? 'line-through decoration-rose-500/70' : ''}`}>{cert.holder_name}</h1>
        <p class="mt-4 text-sm text-stone-600">đã hoàn thành toàn bộ khoá học</p>
        <p class="mt-2 font-serif text-xl sm:text-2xl font-bold break-words">
          {cert.course_slug ? <a href={`/courses/${cert.course_slug}`} class="underline decoration-amber-500/60 underline-offset-4 hover:decoration-amber-600">{cert.course_title}</a> : cert.course_title}
        </p>
        <dl class="mt-8 grid gap-3 sm:grid-cols-2 text-sm">
          <div class="rounded-xl bg-white/70 border border-stone-200 px-3 py-2"><dt class="text-xs text-stone-500">Ngày cấp</dt><dd class="font-semibold"><time datetime={cert.issued_at}>{issued}</time></dd></div>
          <div class="rounded-xl bg-white/70 border border-stone-200 px-3 py-2"><dt class="text-xs text-stone-500">Mã xác minh</dt><dd class="font-mono font-semibold">{cert.code}</dd></div>
        </dl>
        <p class="mt-8 text-xs text-stone-500">Cấp bởi Duy Nguyen (Zuey) · zuey.me. Trang này là nguồn xác minh chính thức: <span class="break-all">{cert.url}</span></p>
      </article>
    ) : (
      <section class="w-full max-w-[720px] bg-[#F5EFEB] rounded-[28px] border border-stone-200/90 p-8 text-center text-stone-900">
        <h1 class="font-serif text-3xl font-bold">{unavailable ? 'Tạm thời không xác minh được' : 'Không tìm thấy chứng chỉ'}</h1>
        <p class="mt-3 text-stone-600">{unavailable ? 'Vui lòng thử lại sau ít phút.' : 'Mã chứng chỉ không tồn tại. Hãy kiểm tra lại đường dẫn.'}</p>
        <a href="/courses" class="mt-6 inline-flex min-h-[44px] items-center rounded-full bg-stone-900 text-white px-5 py-2.5 text-sm font-bold">Xem các khoá học</a>
      </section>
    )}
  </main>
</Layout>
