---
import Layout from '../layouts/Layout.astro';
import { LOCALE_LABELS, resolveLocale } from '../lib/i18n/locales';

// Vietnamese is the authoritative version; every other locale reads the English translation.
const locale = resolveLocale(Astro.request);
const lang: 'vi' | 'en' = locale === 'vi' ? 'vi' : 'en';
Astro.response.headers.set('Vary', 'Cookie, Accept-Language');

const EFFECTIVE = '2026-10-11';
const CONTACT = 'hi@zuey.me';

interface Section {
  id: string;
  title: string;
  paras?: string[];
  items?: string[];
}

interface AnalyticsCopy {
  title: string;
  paras: string[];
  neverTitle: string;
  never: string[];
  controlTitle: string;
  granted: string;
  optedOut: string;
  dnt: string;
  noScript: string;
  optOut: string;
  optIn: string;
  saved: string;
  storageBlocked: string;
}

interface Processor {
  name: string;
  purpose: string;
  data: string;
}

const content: Record<'vi' | 'en', {
  title: string;
  intro: string;
  effective: string;
  authoritative: string;
  pledgeTitle: string;
  pledges: string[];
  sections: Section[];
  analytics: AnalyticsCopy;
  processorsTitle: string;
  processorsIntro: string;
  processorsHead: [string, string, string];
  processors: Processor[];
  processorsNote: string;
  retentionTitle: string;
  retention: string[];
  rightsTitle: string;
  rights: string[];
  contactTitle: string;
  contact: string;
  back: string;
  pending: string;
}> = {
  vi: {
    title: 'Chính sách quyền riêng tư',
