---
import '../../styles/global.css';
import { StudioApp } from '../../components/studio/StudioApp';
import { getProfile, getLinks, listApiKeys, verifySession } from '../../db/store';
import type { ApiKey } from '../../db/types';

const d1 = Astro.locals.runtime?.env?.DB;

// 1. Check session cookie first
const cookie = Astro.request.headers.get('cookie') || '';
const match = cookie.match(/(?:^|;\s*)zuey_session=([^;]+)/);
const sessionToken = match ? decodeURIComponent(match[1]) : null;
const isAuthenticated = sessionToken ? await verifySession(sessionToken, d1) : false;

// 2. Gate sensitive keys behind authentication
const profile = await getProfile(d1);
const links = await getLinks(d1);
const keys: ApiKey[] = isAuthenticated ? await listApiKeys(d1) : [];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zuey.me — Page Builder Studio</title>
    <link rel="icon" type="image/png" href="https://cdn.zuey.me/avatar.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..900&family=Plus+Jakarta+Sans:wght@300..800&family=JetBrains+Mono:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-stone-950 text-stone-100 min-h-screen antialiased selection:bg-amber-400 selection:text-stone-950">
    <StudioApp
      client:load
      initialProfile={profile}
      initialLinks={links}
      initialKeys={keys}
      isAuthenticated={isAuthenticated}
    />
  </body>
</html>
